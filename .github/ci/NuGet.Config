<?xml version="1.0" encoding="utf-8"?>
<!-- CI-only package sources: the lextudio closure comes from GitHub Packages (authenticated
     through NuGetPackageSourceCredentials_lextudio_github), everything else from nuget.org.
     Deliberately no packageSourceMapping: the repository's local-dev NuGet.Config maps the
     closure to local feeds, which do not exist on a runner. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="lextudio_github" value="https://nuget.pkg.github.com/lextudio/index.json" />
  </packageSources>
</configuration>
